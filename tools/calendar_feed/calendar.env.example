# PaceKeeper Dial calendar relay — copy to ~/.config/pacekeeper/calendar.env
# and fill in. This file is read by calendar_feed.py at start-up; it holds a
# secret (the .ics address is a bearer URL) so it lives outside the repo and
# should be chmod 600. Real environment variables of the same name win.

# Required. Google Calendar -> Settings -> (your calendar) -> Integrate
# calendar -> "Secret address in iCal format". Anyone with this URL can read
# the whole calendar: never paste it into the repo, an issue or a chat.
# Shipped commented out on purpose, so an unedited copy of this file fails
# clearly ("ICS_URL is not set") instead of trying CHANGE-ME as a real URL.
# Uncomment and fill in your own address.
#ICS_URL=https://calendar.google.com/calendar/ical/CHANGE-ME/basic.ics

# Your address on that calendar. Events where you are an ATTENDEE with
# PARTSTAT=DECLINED are dropped. Leave blank to keep declined events.
MY_EMAIL=you@example.com

# Optional. TCP port for the LAN listener (default 8765).
#PORT=8765

# Optional. Shared secret. When set, /calendar.json requires ?k=<TOKEN> and
# the Dial must be built with a matching CALENDAR_TOKEN. Unset means anyone
# on the LAN can read your meeting titles. Generate with: openssl rand -hex 24
#TOKEN=

# Optional. IANA time zone for the "now -> end of tomorrow" window and for
# all-day events (default Europe/London).
#TZ=Europe/London

# Optional. Interface to bind (default 0.0.0.0, i.e. reachable on the LAN).
#BIND=0.0.0.0
