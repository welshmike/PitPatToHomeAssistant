#pragma once
#include <Arduino.h>

// your network SSID (name)
#define DEFAULT_STA_WIFI_SSID "wifissid"
// your network password (use for WPA)
#define DEFAULT_STA_WIFI_PASS "wifipass" 

// mqtt server
#define MQTT_SERVER "192.168.2.50"
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASS ""

// treadmill bluetooth address
#define TARGET_ADDRESS "AB:CD:EF:12:34:56"

// Local timezone as a POSIX TZ string (see `man tzset`, or the tz database's
// zone.tab for a given zone's POSIX-TZ notes) — used by TimeService to turn
// NTP's UTC time into local time on the Dial's clock card. Default below is
// Europe/London. TimeService.h falls back to the same string if this is
// omitted, so existing config.h files (from before this macro existed) keep
// building without an edit — only add this line to pick a different zone.
#define TIMEZONE_TZ "GMT0BST,M3.5.0/1,M10.5.0"

// Airline logos for the Dial's Flights card (spec 4.11). Home Assistant
// serves its `config/www/` directory at `/local/`, so dropping the PNGs in
// Since 2026-09-09 the Mac mini relay (tools/calendar_feed, the same process
// that serves the calendar) serves each airline's logo pre-rendered as raw
// RGB565 at `<this>/logo/{IATA}.565`, so the Dial does no PNG decoding.
// FlightsService.h falls back to exactly the line below if this is omitted;
// only add it if the relay is not at macmini.lan:8765. Scheme, host and
// optional port only — no trailing path.
#define FLIGHTS_LOGO_BASE_URL "http://macmini.lan:8765"

// Calendar card (spec 4.19, amended 2026-09-07): a small Python relay on the
// always-on Mac mini turns the work Google Calendar into the compact JSON
// this URL serves — see doc/CALENDAR_FEED.md for the relay's setup and
// payload. Leave CALENDAR_URL undefined to build without the card.
// CALENDAR_TOKEN is optional — only needed if the relay's own TOKEN is set
// (doc/CALENDAR_FEED.md's Privacy section); CalendarService picks a plain
// WiFiClient or WiFiClientSecure from the URL's scheme, so an https:// URL
// (e.g. talking to Google directly) still works too.
#define CALENDAR_URL "http://macmini.lan:8765/calendar.json"
// #define CALENDAR_TOKEN "long-random-string"
