#pragma once
#include <Arduino.h>

// your network SSID (name)
#define DEFAULT_STA_WIFI_SSID "wifissid"
// your network password (use for WPA)
#define DEFAULT_STA_WIFI_PASS "wifipass" 

// mqtt server
#define MQTT_SERVER "192.168.2.50"
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASS ""

// treadmill bluetooth address
#define TARGET_ADDRESS "AB:CD:EF:12:34:56"

// Local timezone as a POSIX TZ string (see `man tzset`, or the tz database's
// zone.tab for a given zone's POSIX-TZ notes) — used by TimeService to turn
// NTP's UTC time into local time on the Dial's clock card. Default below is
// Europe/London. TimeService.h falls back to the same string if this is
// omitted, so existing config.h files (from before this macro existed) keep
// building without an edit — only add this line to pick a different zone.
#define TIMEZONE_TZ "GMT0BST,M3.5.0/1,M10.5.0"

// Airline logos for the Dial's Flights card (spec 4.11). Home Assistant
// serves its `config/www/` directory at `/local/`, so dropping the PNGs in
// `config/www/logos/{IATA}.png` makes them plain-HTTP files on the LAN and
// the Dial fetches `<this>/logos/{IATA}.png`. FlightsService.h falls back
// to exactly the line below if this is omitted, so existing config.h files
// keep building — only add it if HA is not on the MQTT broker's host or
// does not use the default 8123 port.
#define FLIGHTS_LOGO_BASE_URL "http://" MQTT_SERVER ":8123/local"


